# Project IVY — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit the filled-in .env.
# This lists the most important credentials/config only; the complete per-Lambda
# list is documented in docs/PROJECT_IVY_STATUS.md.

# --- AWS ---
AWS_REGION=ap-southeast-2

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_BOT_USER_ID=U000000

# --- Image analysis (OCR -> Gemini) ---
# Name/ARN of the Lambda the worker invokes for image analysis.
IMAGE_REK_FUNCTION=O3_Image_OCR
# OCR engine used inside that Lambda: paddleocr | easyocr | textract | mistral-ocr
OCR_ENGINE=paddleocr

# --- Gemini (image-text LLM) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- Optional OCR cloud engines ---
MISTRAL_API_KEY=your-mistral-api-key

# --- Amazon Lex ---
BOT_ID=your-lex-bot-id
BOT_ALIAS_ID=your-lex-bot-alias-id
LOCALE_ID=en_US

# --- Bedrock Knowledge Base (optional fallback) ---
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_KB_MODEL_ARN=

# --- Jira / Atlassian (ticket creation, Rovo) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=IVY
ATLASSIAN_DOMAIN=your-domain.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token
