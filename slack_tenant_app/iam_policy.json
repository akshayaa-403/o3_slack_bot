{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/slack_tenant_app:*"
    },
    {
      "Sid": "TenantDataTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/tenants",
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/tenants/index/*",
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/intents",
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/conversations",
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/tenant_workspace_registry"
      ]
    },
    {
      "Sid": "TenantBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:HeadBucket",
        "s3:CreateBucket"
      ],
      "Resource": "arn:aws:s3:::tenant-data-*"
    },
    {
      "Sid": "ConnectorTokenEncryption",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:REGION:ACCOUNT_ID:key/KMS_KEY_ARN_ID"
    }
  ]
}
